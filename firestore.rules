rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL DEFAULT-DENY SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // SHARED PRIMITIVES & RBAC HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerifiedOwner(userId) { return isVerifiedUser() && request.auth.uid == userId; }
    
    // Admin Check: Consolidated based on UID in admins/staffMembers collections
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staffMembers/$(request.auth.uid))
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // =========================================================================
    // COLLECTION MATCH BLOCKS
    // =========================================================================

    // 1. ADMINS & STAFF
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    
    match /staffMembers/{staffUid} {
      allow get: if isSignedIn() && (isOwner(staffUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == staffUid;
      allow update, delete: if isAdmin();
    }

    // 2. CATEGORIES
    match /categories/{categoryId} {
      allow get: if (resource == null || existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. PRODUCTS
    match /products/{productId} {
      allow get: if (resource == null || existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 4. COUPONS
    match /coupons/{couponId} {
      allow get: if (resource == null || existing().isActive == true || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 5. USERS & PRIVATE PROFILE
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /private/{docId} {
        allow get, update: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
      }

      match /addresses/{addressId} {
        allow get, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /cart/{cartItemId} {
        allow get, create, update, delete: if isOwner(userId);
      }
    }

    // 6. PRESCRIPTIONS & ORDERS
    match /prescriptionReviews/{prescriptionId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().status == 'pending_review');
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(existing().userId) && !existing().cancellationRequested);
      
      match /items/{itemId} {
        allow get, list, create: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // 7. NOTIFICATIONS & SUPPORT
    match /notifications/{notificationId} {
      allow get, list, update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isOwner(existing().userId) && existing().status != 'closed');
    }

    // 8. SITE SETTINGS & AUDIT
    match /siteSettings/{settingId} {
      allow get: if true;
      allow update: if isAdmin();
    }
    
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
    }

    // 9. TEST CONNECTION
    match /test/connection {
      allow read: if true;
    }
  }
}
