rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL DEFAULT-DENY SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // SHARED PRIMITIVES & RBAC HELPERS
    // =========================================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // অ্যাডমিন মালিকানা এখন সম্পূর্ণ ডেটাবেজ-ভিত্তিক (UID নির্ভর)
    // কোনো ইমেইল হার্ডকোড করা নেই।
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staffMembers/$(request.auth.uid))
      );
    }
    
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 9. TEST CONNECTION
    match /test/connection {
      allow read: if true;
    }

    // =========================================================================
    // COLLECTION MATCH BLOCKS
    // =========================================================================

    // 1. STAFF REGISTRATION (সহজ করা হয়েছে)
    match /staffMembers/{staffUid} {
      // নিজের প্রোফাইল রিড করতে পারবে, অ্যাডমিন সবাইকে পারবে
      allow get: if isSignedIn() && (request.auth.uid == staffUid || isAdmin());
      // যে কেউ নিজের প্রোফাইল তৈরি করতে পারবে (সহজ রেজিস্ট্রেশন)
      allow create: if isSignedIn() && request.auth.uid == staffUid;
      // শুধুমাত্র অ্যাডমিনরাই অন্য স্টাফদের এডিট বা ডিলিট করতে পারবে
      allow update, delete: if isAdmin();
      allow list: if isAdmin();
    }
    
    // 2. ADMINS
    match /admins/{adminId} {
      allow get, list: if isAdmin();
      // সুপার অ্যাডমিন নিজেই অন্য কাউকে অ্যাডমিন বানাতে পারবে
      allow create, update, delete: if isSuperAdmin();
    }

    // 3. CATEGORIES
    match /categories/{categoryId} {
      allow get: if (resource == null || request.resource.data.isActive == true || isAdmin());
      allow list: if isAdmin(); // বা পাব্লিকলি রিড অ্যালাউ করতে চাইলে শর্ত দিন
      allow create, update, delete: if isAdmin();
    }

    // 4. PRODUCTS
    match /products/{productId} {
      allow get: if (resource == null || request.resource.data.isActive == true || isAdmin());
      allow list: if isAdmin(); 
      allow create, update, delete: if isAdmin();
    }

    // 5. COUPONS & SITE SETTINGS
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow get: if true;
      allow update: if isAdmin();
    }

    // 6. USERS & ORDERS (পাব্লিক ইউজারদের জন্য)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && !resource.data.cancellationRequested);
    }
  }
}
