rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GLOBAL DEFAULT-DENY SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HARDENED PRIMITIVES & RBAC HELPERS
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn();
    }

    function staffPath(uid) {
      return /databases/$(database)/documents/staffMembers/$(uid);
    }

    function isActiveStaffWithRole(allowedRoles) {
      return isBootstrappedSuperAdmin() || (
        isVerifiedUser() &&
        exists(staffPath(request.auth.uid)) &&
        get(staffPath(request.auth.uid)).data.status == 'active' &&
        get(staffPath(request.auth.uid)).data.role in allowedRoles
      );
    }

    function isSuperAdmin() {
      return isActiveStaffWithRole(['super_admin']);
    }

    function isAdminManager() {
      return isActiveStaffWithRole(['super_admin', 'store_admin']);
    }

    function isCatalogStaff() {
      return isActiveStaffWithRole(['super_admin', 'store_admin', 'inventory_manager']);
    }

    function isOrderStaff() {
      return isActiveStaffWithRole(['super_admin', 'store_admin', 'order_manager']);
    }

    function isSupportStaff() {
      return isActiveStaffWithRole(['super_admin', 'store_admin', 'customer_support']);
    }

    function isPiiAuthorizedStaff() {
      return isActiveStaffWithRole(['super_admin', 'store_admin', 'order_manager', 'customer_support']);
    }

    function isAnyActiveStaff() {
      return isActiveStaffWithRole([
        'super_admin', 'store_admin', 'inventory_manager',
        'order_manager', 'customer_support', 'analyst'
      ]);
    }

    // Zero-DB-lookup list guard (Pillar 8 Cost-Optimization & Query Enforcer)
    function canStaffList(docData) {
      return isVerifiedUser() &&
        docData.storeId == 'finesteride-recur-bd' &&
        (
          isBootstrappedSuperAdmin() ||
          (docData.authorizedStaffUids is list && request.auth.uid in docData.authorizedStaffUids)
        );
    }

    function isValidStaffUidArray(arr) {
      return arr is list &&
        arr.size() <= 20 &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 128));
    }

    function isValidBoundedStringArray(arr, maxItems, maxStrLen) {
      return arr is list &&
        arr.size() <= maxItems &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxStrLen));
    }

    // -------------------------------------------------------------------------
    // VALIDATION BLUEPRINTS (Pillar 2 — Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidStaffMember(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'status', 'department',
          'licenseNumber', 'storeId', 'authorizedStaffUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'status', 'department',
          'licenseNumber', 'storeId', 'authorizedStaffUids', 'createdBy',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['super_admin', 'store_admin', 'inventory_manager', 'order_manager', 'customer_support', 'analyst'] &&
        data.status in ['active', 'suspended'] &&
        data.department is string && data.department.size() <= 80 &&
        data.licenseNumber is string && data.licenseNumber.size() <= 64 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'name', 'nameBn', 'slug', 'description', 'iconName', 'imageUrl',
          'parentCategoryId', 'displayOrder', 'publicationStatus',
          'activeProductCount', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'nameBn', 'slug', 'description', 'iconName', 'imageUrl',
          'parentCategoryId', 'displayOrder', 'publicationStatus',
          'activeProductCount', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.nameBn is string && data.nameBn.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.description is string && data.description.size() <= 500 &&
        data.iconName is string && data.iconName.size() <= 40 &&
        data.imageUrl is string && data.imageUrl.size() <= 500 &&
        data.parentCategoryId is string && data.parentCategoryId.size() <= 128 &&
        data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 10000 &&
        data.publicationStatus in ['published', 'hidden'] &&
        data.activeProductCount is number && data.activeProductCount >= 0 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'slug', 'genericName', 'manufacturer', 'categoryId',
          'categoryName', 'subcategory', 'description', 'images', 'unitSize',
          'sellingPrice', 'previousPrice', 'stockQuantity', 'lowStockThreshold',
          'sku', 'availabilityStatus', 'prescriptionType', 'usageInstructions',
          'storageInstructions', 'nearestExpiryDate', 'publicationStatus',
          'featured', 'popular', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'slug', 'genericName', 'manufacturer', 'categoryId',
          'categoryName', 'subcategory', 'description', 'images', 'unitSize',
          'sellingPrice', 'previousPrice', 'stockQuantity', 'lowStockThreshold',
          'sku', 'availabilityStatus', 'prescriptionType', 'usageInstructions',
          'storageInstructions', 'nearestExpiryDate', 'publicationStatus',
          'featured', 'popular', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.genericName is string && data.genericName.size() <= 160 &&
        data.manufacturer is string && data.manufacturer.size() >= 1 && data.manufacturer.size() <= 120 &&
        isValidId(data.categoryId) &&
        data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 100 &&
        data.subcategory is string && data.subcategory.size() <= 100 &&
        data.description is string && data.description.size() <= 2000 &&
        isValidBoundedStringArray(data.images, 6, 500) &&
        data.unitSize is string && data.unitSize.size() >= 1 && data.unitSize.size() <= 80 &&
        data.sellingPrice is number && data.sellingPrice >= 0 && data.sellingPrice <= 1000000 &&
        data.previousPrice is number && data.previousPrice >= 0 && data.previousPrice <= 1000000 &&
        data.stockQuantity is number && data.stockQuantity >= 0 && data.stockQuantity <= 1000000 &&
        data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 10000 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 && data.sku.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.availabilityStatus in ['in_stock', 'low_stock', 'out_of_stock', 'expired_restricted'] &&
        data.prescriptionType in ['otc', 'prescription_required', 'pharmacist_verified'] &&
        data.usageInstructions is string && data.usageInstructions.size() <= 1000 &&
        data.storageInstructions is string && data.storageInstructions.size() <= 500 &&
        data.nearestExpiryDate is string && data.nearestExpiryDate.size() <= 32 &&
        data.publicationStatus in ['published', 'draft', 'archived'] &&
        !(data.availabilityStatus == 'expired_restricted' && data.publicationStatus == 'published' && data.stockQuantity > 0) &&
        data.featured is bool &&
        data.popular is bool &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductBatch(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'sku', 'batchNumber', 'supplierName',
          'supplierContact', 'unitCostPrice', 'quantityReceived',
          'quantityRemaining', 'manufacturingDate', 'expiryDate', 'status',
          'notes', 'recordedByUid', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'productId', 'productName', 'sku', 'batchNumber', 'supplierName',
          'supplierContact', 'unitCostPrice', 'quantityReceived',
          'quantityRemaining', 'manufacturingDate', 'expiryDate', 'status',
          'notes', 'recordedByUid', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 &&
        data.batchNumber is string && data.batchNumber.size() >= 1 && data.batchNumber.size() <= 64 && data.batchNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 120 &&
        data.supplierContact is string && data.supplierContact.size() <= 120 &&
        data.unitCostPrice is number && data.unitCostPrice >= 0 && data.unitCostPrice <= 1000000 &&
        data.quantityReceived is number && data.quantityReceived >= 1 && data.quantityReceived <= 1000000 &&
        data.quantityRemaining is number && data.quantityRemaining >= 0 && data.quantityRemaining <= data.quantityReceived &&
        data.manufacturingDate is string && data.manufacturingDate.size() <= 32 &&
        data.expiryDate is string && data.expiryDate.size() >= 10 && data.expiryDate.size() <= 32 &&
        data.status in ['active', 'near_expiry', 'expired_quarantined', 'depleted'] &&
        data.notes is string && data.notes.size() <= 500 &&
        data.recordedByUid is string && data.recordedByUid.size() >= 1 && data.recordedByUid.size() <= 128 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryMovement(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'sku', 'batchNumber', 'movementType',
          'quantityDelta', 'previousStock', 'newStock', 'reason',
          'performedByUid', 'performedByEmail', 'storeId',
          'authorizedStaffUids', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'productId', 'productName', 'sku', 'batchNumber', 'movementType',
          'quantityDelta', 'previousStock', 'newStock', 'reason',
          'performedByUid', 'performedByEmail', 'storeId',
          'authorizedStaffUids', 'createdAt'
        ]) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 &&
        data.batchNumber is string && data.batchNumber.size() <= 64 &&
        data.movementType in ['stock_in', 'adjustment_add', 'adjustment_deduct', 'order_reserved', 'order_restocked', 'expired_quarantine'] &&
        data.quantityDelta is number &&
        data.previousStock is number && data.previousStock >= 0 &&
        data.newStock is number && data.newStock >= 0 &&
        data.previousStock + data.quantityDelta == data.newStock &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400 &&
        data.performedByUid == request.auth.uid &&
        data.performedByUid.size() <= 128 &&
        data.performedByEmail is string && data.performedByEmail.size() >= 3 && data.performedByEmail.size() <= 254 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'accountStatus', 'orderCount',
          'totalSpentBdt', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'accountStatus', 'orderCount',
          'totalSpentBdt', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.accountStatus in ['active', 'suspended', 'deletion_requested'] &&
        data.orderCount is number && data.orderCount >= 0 &&
        data.totalSpentBdt is number && data.totalSpentBdt >= 0 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'phone', 'deliveryAddress', 'city',
          'deliveryZone', 'deletionReason', 'storeId',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'phone', 'deliveryAddress', 'city',
          'deliveryZone', 'deletionReason', 'storeId',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.deliveryAddress is string && data.deliveryAddress.size() <= 400 &&
        data.city is string && data.city.size() <= 80 &&
        data.deliveryZone is string && data.deliveryZone.size() <= 80 &&
        data.deletionReason is string && data.deletionReason.size() <= 300 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'customerId', 'customerName', 'customerPhone',
          'shippingAddress', 'deliveryZone', 'deliveryInstructions',
          'itemCount', 'itemsSummary', 'subtotalBdt', 'discountBdt',
          'couponCode', 'deliveryFeeBdt', 'totalAmountBdt', 'paymentMethod',
          'paymentStatus', 'transactionReference', 'paymentVerifiedAt',
          'requiresPrescription', 'prescriptionReviewId',
          'prescriptionReviewStatus', 'orderStatus', 'courierName',
          'trackingReference', 'cancellationReason', 'storeId',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber', 'customerId', 'customerName', 'customerPhone',
          'shippingAddress', 'deliveryZone', 'deliveryInstructions',
          'itemCount', 'itemsSummary', 'subtotalBdt', 'discountBdt',
          'couponCode', 'deliveryFeeBdt', 'totalAmountBdt', 'paymentMethod',
          'paymentStatus', 'transactionReference', 'paymentVerifiedAt',
          'requiresPrescription', 'prescriptionReviewId',
          'prescriptionReviewStatus', 'orderStatus', 'courierName',
          'trackingReference', 'cancellationReason', 'storeId',
          'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 && data.orderNumber.matches('^[A-Z0-9\\-]+$') &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 32 &&
        data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 400 &&
        data.deliveryZone is string && data.deliveryZone.size() >= 1 && data.deliveryZone.size() <= 80 &&
        data.deliveryInstructions is string && data.deliveryInstructions.size() <= 300 &&
        data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100 &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 300 &&
        data.subtotalBdt is number && data.subtotalBdt >= 0 &&
        data.discountBdt is number && data.discountBdt >= 0 && data.discountBdt <= data.subtotalBdt &&
        data.couponCode is string && data.couponCode.size() <= 40 &&
        data.deliveryFeeBdt is number && data.deliveryFeeBdt >= 0 &&
        data.totalAmountBdt is number && data.totalAmountBdt >= 0 &&
        data.paymentMethod in ['cod', 'bkash', 'nagad'] &&
        data.paymentStatus in ['unpaid', 'pending_verification', 'verified_paid', 'refund_pending', 'refunded', 'failed'] &&
        data.transactionReference is string && data.transactionReference.size() <= 100 &&
        data.paymentVerifiedAt is string && data.paymentVerifiedAt.size() <= 40 &&
        data.requiresPrescription is bool &&
        data.prescriptionReviewId is string && data.prescriptionReviewId.size() <= 128 &&
        data.prescriptionReviewStatus in ['not_required', 'pending_review', 'approved', 'rejected', 'more_info_requested'] &&
        data.orderStatus in [
          'pending', 'awaiting_review', 'confirmed', 'processing',
          'ready_for_dispatch', 'shipped', 'delivered', 'cancelled',
          'refund_pending', 'refunded'
        ] &&
        data.courierName is string && data.courierName.size() <= 80 &&
        data.trackingReference is string && data.trackingReference.size() <= 100 &&
        data.cancellationReason is string && data.cancellationReason.size() <= 300 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function passesPrescriptionGate(orderData) {
      return !orderData.requiresPrescription ||
        !(orderData.orderStatus in ['confirmed', 'processing', 'ready_for_dispatch', 'shipped', 'delivered']) ||
        (
          orderData.prescriptionReviewStatus == 'approved' &&
          isValidId(orderData.prescriptionReviewId) &&
          existsAfter(/databases/$(database)/documents/prescriptionReviews/$(orderData.prescriptionReviewId)) &&
          getAfter(/databases/$(database)/documents/prescriptionReviews/$(orderData.prescriptionReviewId)).data.reviewStatus == 'approved'
        );
    }

    function isValidOrderItem(data) {
      return data.keys().hasAll([
          'orderId', 'productId', 'productName', 'genericName',
          'manufacturer', 'unitSize', 'sku', 'batchNumber', 'unitPriceBdt',
          'quantity', 'lineTotalBdt', 'prescriptionRequired', 'customerId',
          'storeId', 'authorizedStaffUids', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'productId', 'productName', 'genericName',
          'manufacturer', 'unitSize', 'sku', 'batchNumber', 'unitPriceBdt',
          'quantity', 'lineTotalBdt', 'prescriptionRequired', 'customerId',
          'storeId', 'authorizedStaffUids', 'createdAt'
        ]) &&
        isValidId(data.orderId) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160 &&
        data.genericName is string && data.genericName.size() <= 160 &&
        data.manufacturer is string && data.manufacturer.size() <= 120 &&
        data.unitSize is string && data.unitSize.size() <= 80 &&
        data.sku is string && data.sku.size() <= 64 &&
        data.batchNumber is string && data.batchNumber.size() <= 64 &&
        data.unitPriceBdt is number && data.unitPriceBdt >= 0 &&
        data.quantity is number && data.quantity >= 1 && data.quantity <= 1000 &&
        data.lineTotalBdt is number && data.lineTotalBdt >= 0 &&
        data.prescriptionRequired is bool &&
        isValidId(data.customerId) &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp;
    }

    function isValidOrderStatusHistory(data) {
      return data.keys().hasAll([
          'orderId', 'fromStatus', 'toStatus', 'note', 'changedByUid',
          'changedByName', 'changedByRole', 'customerId', 'storeId',
          'authorizedStaffUids', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'fromStatus', 'toStatus', 'note', 'changedByUid',
          'changedByName', 'changedByRole', 'customerId', 'storeId',
          'authorizedStaffUids', 'createdAt'
        ]) &&
        isValidId(data.orderId) &&
        data.fromStatus is string && data.fromStatus.size() <= 40 &&
        data.toStatus is string && data.toStatus.size() >= 1 && data.toStatus.size() <= 40 &&
        data.note is string && data.note.size() >= 1 && data.note.size() <= 400 &&
        data.changedByUid == request.auth.uid &&
        data.changedByUid.size() <= 128 &&
        data.changedByName is string && data.changedByName.size() >= 1 && data.changedByName.size() <= 120 &&
        data.changedByRole is string && data.changedByRole.size() >= 1 && data.changedByRole.size() <= 40 &&
        isValidId(data.customerId) &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp;
    }

    function isValidPrescriptionReview(data) {
      return data.keys().hasAll([
          'orderId', 'orderNumber', 'customerId', 'customerName',
          'medicineSummary', 'documentUrl', 'documentMimeType',
          'prescriberName', 'clinicOrHospital', 'prescriptionIssueDate',
          'reviewStatus', 'reviewerUid', 'reviewerName', 'reviewerLicense',
          'reviewNotes', 'reviewedAt', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderId', 'orderNumber', 'customerId', 'customerName',
          'medicineSummary', 'documentUrl', 'documentMimeType',
          'prescriberName', 'clinicOrHospital', 'prescriptionIssueDate',
          'reviewStatus', 'reviewerUid', 'reviewerName', 'reviewerLicense',
          'reviewNotes', 'reviewedAt', 'storeId', 'authorizedStaffUids',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.orderId) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 40 &&
        isValidId(data.customerId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.medicineSummary is string && data.medicineSummary.size() >= 1 && data.medicineSummary.size() <= 300 &&
        data.documentUrl is string && data.documentUrl.size() >= 5 && data.documentUrl.size() <= 600 &&
        data.documentMimeType is string && data.documentMimeType.size() <= 64 &&
        data.prescriberName is string && data.prescriberName.size() >= 2 && data.prescriberName.size() <= 120 &&
        data.clinicOrHospital is string && data.clinicOrHospital.size() <= 160 &&
        data.prescriptionIssueDate is string && data.prescriptionIssueDate.size() >= 10 && data.prescriptionIssueDate.size() <= 32 &&
        data.reviewStatus in ['pending_review', 'approved', 'rejected', 'more_info_requested'] &&
        data.reviewerUid is string && data.reviewerUid.size() <= 128 &&
        data.reviewerName is string && data.reviewerName.size() <= 120 &&
        data.reviewerLicense is string && data.reviewerLicense.size() <= 64 &&
        data.reviewNotes is string && data.reviewNotes.size() <= 600 &&
        data.reviewedAt is string && data.reviewedAt.size() <= 40 &&
        data.storeId == 'finesteride-recur-bd' &&
        isValidStaffUidArray(data.authorizedStaffUids) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll([
          'code', 'description', 'discountType', 'discountValue',
          'minOrderAmountBdt', 'maxDiscountBdt', 'startDate', 'endDate',
          'usageLimit', 'usedCount', 'applicableCategory', 'status',
          'storeId', 'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'description', 'discountType', 'discountValue',
          'minOrderAmountBdt', 'maxDiscountBdt', 'startDate', 'endDate',
          'usageLimit', 'usedCount', 'applicableCategory', 'status',
          'storeId', 'authorizedStaffUids', 'createdAt', 'updatedAt'
        ]) &&
        data.code is string && data.code.size() >= 3 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$') &&
        data.description is string && data.description.size() <= 240 &&
        data.discountType in ['percentage', 'fixed_bdt'] &&
        data.discountValue is number && data.discountValue > 0 && data.discountValue <= 100000 &&
        data.minOrderAmountBdt is number && data.minOrderAmountBdt >= 0 &&
        data.maxDiscountBdt is number && data.maxDiscountBdt >= 0 &&
        data.startDate is string && data.startDate.size() >= 10 && data.startDate.size() <= 32 &&
