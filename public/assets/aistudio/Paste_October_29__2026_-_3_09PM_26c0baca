            existing().reviewStatus == 'more_info_requested' &&
            incoming().reviewStatus == 'pending_review' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'documentUrl', 'documentMimeType', 'prescriberName',
              'clinicOrHospital', 'prescriptionIssueDate', 'reviewStatus',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 9. COUPONS & PROMOTIONS
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (
        (isVerifiedUser() && existing().status == 'active') ||
        isAnyActiveStaff()
      );
      allow list: if (isVerifiedUser() && existing().status == 'active') || canStaffList(existing());

      allow create: if isVerifiedUser() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdminManager();

      allow update: if isVerifiedUser() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isAdminManager() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'description', 'discountType', 'discountValue',
              'minOrderAmountBdt', 'maxDiscountBdt', 'startDate', 'endDate',
              'usageLimit', 'usedCount', 'applicableCategory', 'status',
              'authorizedStaffUids', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(couponId) && isAdminManager();
    }

    // 10. DELIVERY ZONES
    match /deliveryZones/{zoneId} {
      allow get: if isValidId(zoneId) && (
        (isVerifiedUser() && existing().status == 'active') ||
        isAnyActiveStaff()
      );
      allow list: if (isVerifiedUser() && existing().status == 'active') || canStaffList(existing());

      allow create: if isVerifiedUser() &&
        isValidId(zoneId) &&
        isValidDeliveryZone(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdminManager();

      allow update: if isVerifiedUser() &&
        isValidId(zoneId) &&
        isValidDeliveryZone(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isAdminManager() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'zoneName', 'coverageAreas', 'deliveryFeeBdt',
              'freeDeliveryMinOrderBdt', 'estimatedDeliveryText',
              'courierPartner', 'instructions', 'status',
              'authorizedStaffUids', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(zoneId) && isAdminManager();
    }

    // 11. SITE SETTINGS & WEBSITE CMS
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && (
        (isVerifiedUser() && existing().storeId == 'finesteride-recur-bd') ||
        isAnyActiveStaff()
      );
      allow list: if canStaffList(existing());

      allow create: if isVerifiedUser() &&
        settingId == 'storefront_config' &&
        isValidSiteSettings(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdminManager();

      allow update: if isVerifiedUser() &&
        settingId == 'storefront_config' &&
        isValidSiteSettings(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            isAdminManager() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'siteName', 'tagline', 'taglineBn', 'logoUrl', 'faviconUrl',
              'heroTitle', 'heroSubtitle', 'heroBannerUrl', 'heroCtaText',
              'promoBannerText', 'featuredCategorySlugs',
              'homepageSectionOrder', 'navigationLinks', 'supportPhone',
              'supportEmail', 'supportHours', 'pharmacyLicenseNo',
              'deliveryInfoPolicy', 'paymentInfoPolicy',
              'enabledPaymentMethods', 'faqContent', 'termsAndConditions',
              'privacyPolicy', 'returnRefundPolicy', 'authorizedStaffUids',
              'updatedByUid', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 12. CUSTOMER SUPPORT TICKETS
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isOwner(existing().customerId) || isSupportStaff());
      allow list: if (isVerifiedUser() && existing().customerId == request.auth.uid) || canStaffList(existing());

      allow create: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().customerId == request.auth.uid &&
            incoming().status == 'open' &&
            incoming().staffResolutionNote == ''
          ) ||
          isSupportStaff()
        );

      allow update: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming()) &&
        incoming().ticketNumber == existing().ticketNumber &&
        incoming().customerId == existing().customerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (
            existing().status != 'closed' &&
            isSupportStaff() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'priority', 'status', 'staffResolutionNote',
              'assignedToUid', 'authorizedStaffUids', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 13. ADMIN AUDIT LOGS (STRICTLY APPEND-ONLY)
    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAdminManager();
      allow list: if canStaffList(existing());

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAdminAuditLog(incoming()) &&
        incoming().createdAt == request.time &&
        isAnyActiveStaff();

      allow update, delete: if false;
    }

    // 14. STAFF WEB PUSH DEVICES (FCM VAPID SUBSCRIPTIONS)
    match /staffPushDevices/{deviceId} {
      allow get: if isValidId(deviceId) && (isOwner(existing().staffUid) || isAdminManager());
      allow list: if (isVerifiedUser() && existing().staffUid == request.auth.uid) || canStaffList(existing());

      allow create: if isVerifiedUser() &&
        isValidId(deviceId) &&
        isValidStaffPushDevice(incoming()) &&
        incoming().deviceId == deviceId &&
        incoming().staffUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAnyActiveStaff();

      allow update: if isVerifiedUser() &&
        isValidId(deviceId) &&
        isValidStaffPushDevice(incoming()) &&
        incoming().deviceId == existing().deviceId &&
        incoming().staffUid == existing().staffUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (isOwner(existing().staffUid) || isSuperAdmin()) &&
        isAnyActiveStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'staffEmail', 'fcmToken', 'vapidKeyPrefix', 'userAgent',
          'status', 'authorizedStaffUids', 'updatedAt'
        ]);

      allow delete: if isValidId(deviceId) && (isOwner(existing().staffUid) || isSuperAdmin());
    }
  }
}
