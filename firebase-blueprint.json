      "required": [
        "orderId", "fromStatus", "toStatus", "note", "changedByUid", "changedByName",
        "changedByRole", "customerId", "storeId", "authorizedStaffUids", "createdAt"
      ]
    },
    "PrescriptionReview": {
      "title": "PrescriptionReview",
      "description": "Protected clinical prescription verification record restricted to customer owner and authorized pharmacy reviewers.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Associated order ID." },
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40, "description": "Associated order number." },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Submitting customer UID." },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Patient / customer name." },
        "medicineSummary": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Prescription-classified items requiring review." },
        "documentUrl": { "type": "string", "minLength": 5, "maxLength": 600, "description": "Private Firebase Storage path or signed preview reference." },
        "documentMimeType": { "type": "string", "maxLength": 64, "description": "Uploaded file MIME type (application/pdf, image/jpeg, image/png)." },
        "prescriberName": { "type": "string", "minLength": 2, "maxLength": 120, "description": "BMDC-registered prescribing physician name." },
        "clinicOrHospital": { "type": "string", "maxLength": 160, "description": "Hospital or chamber name." },
        "prescriptionIssueDate": { "type": "string", "minLength": 10, "maxLength": 32, "description": "Issue date YYYY-MM-DD." },
        "reviewStatus": {
          "type": "string",
          "enum": ["pending_review", "approved", "rejected", "more_info_requested"],
          "description": "Clinical verification decision."
        },
        "reviewerUid": { "type": "string", "maxLength": 128, "description": "UID of qualified reviewer." },
        "reviewerName": { "type": "string", "maxLength": 120, "description": "Name of qualified reviewer." },
        "reviewerLicense": { "type": "string", "maxLength": 64, "description": "Reviewer Pharmacy Council registration ID." },
        "reviewNotes": { "type": "string", "maxLength": 600, "description": "Clinical verification notes or patient follow-up request." },
        "reviewedAt": { "type": "string", "maxLength": 40, "description": "ISO review timestamp." },
        "storeId": { "type": "string", "maxLength": 64, "description": "Shared store identifier." },
