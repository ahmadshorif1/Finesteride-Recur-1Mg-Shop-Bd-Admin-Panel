# GEMINI_API_KEY: Optional server-side API key if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Shared Firebase Project Configuration (Customer Storefront + Admin Panel)
# Note: Firebase Web API keys identify the Firebase project; they do NOT grant administrative authority.
# Administrative access is enforced via Firebase Authentication, Firestore Security Rules, and trusted backend verification.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
# Firebase Cloud Messaging Web Push Certificate Key Pair (Public VAPID Key)
VITE_FIREBASE_VAPID_KEY="BKo5qev_gQH2OPwkHgRsKpGPMXVVbpeFVLEAwZNkO6nPlfWriuVOAqfICwUGDD0zM6CcEEhPA95lScKpimlwgpo"
# Must be literally "(default)" for standard Firebase Cloud Firestore databases (do not enter project name)
VITE_FIREBASE_DATABASE_ID="(default)"
# Optional comma-separated verified Super Admin email(s)
VITE_SUPER_ADMIN_EMAIL=""

# OPTIONAL BANGLADESH PAYMENT GATEWAY SERVER CREDENTIALS (Backend Only - Never expose VITE_ prefix)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
